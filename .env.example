# Happy Cone local development settings
#
# Copy this file to .env and replace the password placeholder before running
# Docker Compose. Do not reuse these development values in a deployment.

POSTGRES_DB=happycone_dev
POSTGRES_USER=happycone_dev
# Use URL-safe characters (letters, numbers, hyphen, underscore) because this
# value is interpolated into DATABASE_URL by Compose.
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# All published ports bind to 127.0.0.1 by default.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080

BRANCH_TIMEZONE=Africa/Lusaka
SESSION_HOURS=12

# JSON list used only when calling the API directly during local development.
# The Compose web container proxies /api on the same origin.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Development seed credentials are intentionally absent. Supply a temporary
# HAPPYCONE_SEED_PASSWORD (at least 12 characters) only when running a seed
# command. Never use the seeded accounts in production.
