# Copy to .env on the deployment host, set real secrets and restrict the file
# to the deployment account (chmod 600 .env).
APP_ENV=production
POSTGRES_DB=happycone
POSTGRES_USER=happycone
POSTGRES_PASSWORD=replace-with-a-long-url-safe-production-secret

# Keep these services private. Put TLS in front of 127.0.0.1:8080.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080

BRANCH_TIMEZONE=Africa/Lusaka
SESSION_HOURS=12
LOG_LEVEL=INFO

# JSON lists. Include the real public DNS name and the internal health-check
# host. Same-origin production deployments normally need no CORS origins.
ALLOWED_HOSTS=["pos.example.com","127.0.0.1"]
CORS_ORIGINS=[]
